# Copy to infrastructure/.env and change the values. Never commit the real file.
POSTGRES_USER=shipdok
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shipdok
REDIS_PASSWORD=change-me-too
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# API
API_HOST=127.0.0.1
API_PORT=4000
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Dashboard origin(s), comma-separated
WEB_ORIGIN=http://localhost:5173
# Optional: if set, required in the first-run setup request
SETUP_TOKEN=
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Master key for app secrets (64 hex chars). Generate: openssl rand -hex 32
APP_SECRETS_KEY=

# Github Web Hook Secret
GITHUB_WEBHOOK_SECRET=