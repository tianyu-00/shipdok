# Shipdok settings. Copy to infrastructure/.env (never commit the real file) and remove the "#" in front of what you want to change.
#
# Running with Docker Compose needs NO .env at all. Everything below is optional and has a default.
# The setup token is not a setting: it is generated on the first run and printed in the API log (docker compose logs api).
# The GitHub App (app ID, private key, webhook secret) is not set here either: connect it on the GitHub page of the dashboard.


# =====================================================================================================================
# Docker Compose: reaching the dashboard
# =====================================================================================================================

# Which address the dashboard listens on. Default 127.0.0.1 (this machine only).
# 0.0.0.0 (or this machine's address) lets other devices on your network open it.
# WEB_BIND=127.0.0.1

# The port the dashboard is published on. Default 8080.
# WEB_HOST_PORT=8080

# The port the API is published on (this machine only). Default 4000.
# API_HOST_PORT=4000


# =====================================================================================================================
# Public access (who may reach Shipdok from outside your network)
# Normally set in the dashboard (Security > Public access). A value here wins and locks the field there.
# =====================================================================================================================

# What outside visitors may do: local (nothing, the default), webhook (only GitHub's push webhook) or full (everything).
# SHIPDOK_PUBLIC=local

# The public address of this Shipdok, as seen from outside, for example the one your reverse proxy or tunnel serves.
# Used to tell GitHub where to send webhooks. Must be an origin: https://host[:port], no path.
# PUBLIC_URL=https://shipdok.example.com

# Reverse proxies whose X-Forwarded-For header is believed (comma-separated addresses or ranges).
# Default: loopback, plus the private ranges inside Docker Compose.
# TRUST_PROXY=loopback,uniquelocal

# Whether the login cookie is marked Secure (sent over https only).
# auto (the default): only when a trusted proxy says the visitor used https. true / false force it.
# COOKIE_SECURE=auto

# Extra addresses the dashboard accepts requests from, comma-separated. Not needed normally: the address you open the
# dashboard at is accepted automatically. Only for a proxy that rewrites the Host header.
# WEB_ORIGIN=https://shipdok.example.com


# =====================================================================================================================
# Apps and monitoring
# =====================================================================================================================

# The range new apps get a host port from when you leave the port empty. Default 20000-20999.
# PORT_RANGE=20000-20999

# How often the worker checks that apps are running and healthy, in milliseconds. Default 15000.
# MONITOR_INTERVAL_MS=15000

# How often the worker samples each app's CPU and memory, in milliseconds. Default 15000.
# STATS_INTERVAL_MS=15000


# =====================================================================================================================
# Secrets (generated on the first run into the shipdok_secrets volume; a value set here is used instead)
# Back up the shipdok_secrets volume together with the database: without APP_SECRETS_KEY the secrets stored in the
# database (app variables, GitHub credentials) cannot be read.
# =====================================================================================================================

# The key that encrypts stored secrets: 64 hex characters (openssl rand -hex 32). Losing it makes them unrecoverable.
# APP_SECRETS_KEY=

# Signs the login session cookie: a long random string, 32 characters or more (openssl rand -hex 32).
# SESSION_SECRET=

# The Postgres password.
# POSTGRES_PASSWORD=

# The Redis password.
# REDIS_PASSWORD=

# The Postgres user and database names. Default shipdok for both.
# POSTGRES_USER=shipdok
# POSTGRES_DB=shipdok


# =====================================================================================================================
# Development only: running the API and worker with npm (npm run dev / npm start / npm test) instead of Docker
# These need the four secrets above (the secrets volume is not used outside Docker).
# =====================================================================================================================

# Where Postgres and Redis are. Inside Docker Compose the service names are used instead.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Where the API listens. Default 127.0.0.1:4000.
# API_HOST=127.0.0.1
# API_PORT=4000

# Where build and runtime logs are stored. Default ~/.shipdok/logs (Docker Compose uses the shipdok_logs volume).
# LOG_DIR=~/.shipdok/logs

# The address the worker uses to health-check a new container. Default 127.0.0.1 (Docker Compose sets this itself).
# HEALTH_CHECK_HOST=127.0.0.1
