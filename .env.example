# Copy to infrastructure/.env and change the values. Never commit the real file.
POSTGRES_USER=shipdok
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shipdok
REDIS_PASSWORD=change-me-too
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# API
API_HOST=127.0.0.1
API_PORT=4000
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Dashboard origin(s), comma-separated
WEB_ORIGIN=http://localhost:5173
# Optional: if set, required in the first-run setup request
SETUP_TOKEN=
# true / false force the Secure flag on the login cookie; leave out (or `auto`) to set it only on requests that came in over https
COOKIE_SECURE=false

# Optional overrides for who may reach Shipdok from outside. Normally you set these in the dashboard (Security > Public access)
# and leave them empty; a value here wins and locks the field in the dashboard.
# SHIPDOK_PUBLIC=local        # local (default) | webhook | full
# PUBLIC_URL=https://shipdok.example.com

# Master key for app secrets (64 hex chars). Generate: openssl rand -hex 32
APP_SECRETS_KEY=

# The GitHub App (app ID, private key, webhook secret) is NOT set here any more: connect it on the GitHub page of the dashboard.
# It is stored there, encrypted with the key above.

DOCKER_GID=1001
PORT_RANGE=20000-20999